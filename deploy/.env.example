# Скопируйте в .env рядом с docker-compose.yml при необходимости переопределения.

POSTGRES_USER=itshop
POSTGRES_PASSWORD=itshop
POSTGRES_DB=itshop

HTTP_PORT=8080
DATABASE_URL=postgres://itshop:itshop@postgres:5432/itshop?sslmode=disable

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=itshop-attachments

IAM_MOCK=true
AI_MOCK=true
CORS_ALLOW_ORIGIN=*
